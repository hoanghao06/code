import numpy as np
import matplotlib.pyplot as plt
import matplotlib.lines as mlines
from channel import total_harvested_energy, get_fso_access, get_snr, data_rate, FSO_bandwidth

def main():
    print("=== TRADE-OFF: POWER & RATE VS ALTITUDE (FIXED ALPHA) ===")

    # Simulation parameters
    alt_min, alt_max, num_alts = 0, 2000, 20
    altitudes = np.linspace(alt_min, alt_max, num_alts)
    alphas = [0.2, 0.4, 0.6, 0.8]
    num_timeslots = 300

    # Fixed coordinates
    hap_pos = np.array([500, 500, 20000])
    irs_pos = np.array([0, 0, 80])

    # === LOAD DATA ===
    base_path = r'C:\Users\DELL\Desktop\nckh\prj1\2026.-Tien_Hao-main\2026.-Tien_Hao-main\main_output\output_rural_10\speed_10\0\flydata\\'
    
    try:
        car_data = np.load(base_path + 'car_3.npy', allow_pickle=True).item()
        car_trajectory = car_data['car_0']
        
        energy_data = np.load(base_path + 'energy_3.npy', allow_pickle=True).item()
        rate_data = np.load(base_path + 'rate_3.npy', allow_pickle=True).item()
        
        print("[+] Loaded data successfully.")
    except Exception as e:
        print(f"[!] File reading error: {e}")
        return 

    # === OPTIMIZED VALUES ===
    opt_rate_mean = np.mean(rate_data['mean_rate'])
    opt_power_mean = np.mean(energy_data['solar energy'] + energy_data['fso energy'] * 0.2)
    
    # Result arrays
    power_results = np.zeros((len(alphas), len(altitudes)))
    rate_results = np.zeros((len(alphas), len(altitudes)))

    # === SIMULATION ===
    print("Running simulation...")
    for i_alt, alt in enumerate(altitudes):
        pos_above = np.array([0, 0, alt])            
        for i_alpha, alpha in enumerate(alphas):
            total_power = 0.0
            total_rate = 0.0

            for t in range(num_timeslots):
                car_pos = car_trajectory[min(t, len(car_trajectory)-1)]

                _, p_sol, _, p_batt, p_tx = total_harvested_energy(
                    hap_pos, irs_pos, pos_above, duration=1, energy_ratio=alpha
                )
                total_power += (p_sol + p_batt)

                h_acc, _, _, _ = get_fso_access(pos_above, car_pos)
                gamma = get_snr(h_acc, p_tx, pos_above)
                total_rate += data_rate(gamma, FSO_bandwidth)

            power_results[i_alpha, i_alt] = total_power / num_timeslots
            rate_results[i_alpha, i_alt] = total_rate / num_timeslots

        print(f"  >> Done altitude {alt:.0f} m")

    # === PLOT ===
    fig, ax1 = plt.subplots(figsize=(14, 9)) 

    # --- THÊM PHÂN VÙNG MÀU NỀN ---
    # Tô màu theo trục X: (xmin, xmax, color, alpha) với alpha là độ trong suốt
    ax1.axvspan(0, 500, facecolor='#f2eedc', alpha=0.8)       # Dưới mây (vàng nhạt)
    ax1.axvspan(500, 1000, facecolor='#d3d3d3', alpha=0.6)    # Trong mây (xám)
    ax1.axvspan(1000, 2000, facecolor='#dcedf2', alpha=0.8)   # Trên mây (xanh lơ nhạt)

    # --- THÊM CHỮ CHÚ THÍCH CHO CÁC VÙNG (VỊ TRÍ LỆCH) ---
    # x: chỉnh vị trí trái/phải trong vùng
    # y: chỉnh độ cao/thấp khác nhau cho tự nhiên
    ax1.text(100, 410, 'Case 1', fontsize=18, color='#333333', fontweight='bold')
    ax1.text(550, 410, 'Case 2', fontsize=18, color='#333333', fontweight='bold')
    ax1.text(1100, 330, 'Case 3', fontsize=18, color='#333333', fontweight='bold')
    
    # Thiết lập giới hạn trục x ngay từ 0 để các mảng màu lấp đầy mép trái
    ax1.set_xlim(0, 2000)

    markers = ['o', 's', '^', 'D']

    # --- POWER (RED) ---
    for i_alpha, alpha in enumerate(alphas):
        ax1.plot(altitudes, power_results[i_alpha],
                 color='red', marker=markers[i_alpha],
                 linestyle='-', linewidth=2, markersize=8,
                 label=rf'Harvested power ($\alpha_{{\mathrm{{split}}}}={alpha}$)')

    ax1.axhline(y=opt_power_mean, color='red', linestyle='-', linewidth=2.5, 
                label='Harvested power with Algorithm 1')

    # GIẢM CỠ CHỮ TÊN TRỤC XUỐNG 24 (TRƯỚC LÀ 28), GIỮ NGUYÊN SỐ LÀ 22
    ax1.set_xlabel('UAV Altitude (m)', fontsize=24)
    ax1.set_ylabel('Average harvested power (W)', color='red', fontsize=24)
    ax1.tick_params(axis='x', labelsize=22)
    ax1.tick_params(axis='y', colors='red', labelsize=22)
    ax1.spines['left'].set_color('red')       
    ax1.spines['left'].set_linewidth(1.5)     
    
    # Giữ nguyên khoảng trống ở trên cho legend
    ax1.set_ylim(bottom=-20, top=600)
    ax1.grid(True, linestyle='--', alpha=0.5)

    # --- RATE (BLUE) ---
    ax2 = ax1.twinx()
    for i_alpha, alpha in enumerate(alphas):
        ax2.plot(altitudes, rate_results[i_alpha],
                 color='blue', marker=markers[i_alpha],
                 linestyle='--', linewidth=2, markersize=8,
                 markerfacecolor='white', markeredgewidth=1.5,
                 label=rf'Data rate ($\alpha_{{\mathrm{{split}}}}={alpha}$)')

    ax2.axhline(y=opt_rate_mean, color='blue', linestyle='--', linewidth=2.5, 
                label='Data rate with Algorithm 1')

    # GIẢM CỠ CHỮ TÊN TRỤC Y PHẢI XUỐNG 24, GIỮ NGUYÊN SỐ LÀ 22
    ax2.set_ylabel('Average data rate (Gbps)', color='blue', fontsize=24)
    ax2.tick_params(axis='y', colors='blue', labelsize=22)
    ax2.spines['right'].set_color('blue')     
    ax2.spines['right'].set_linewidth(1.5)    

    ax2.set_ylim(bottom=1.8, top=8.2)

    # --- SẮP XẾP LẠI LEGEND THEO 2 CỘT ---
    handles1, labels1 = ax1.get_legend_handles_labels()
    handles2, labels2 = ax2.get_legend_handles_labels()

    new_handles = handles1 + handles2
    new_labels = labels1 + labels2

    legend = ax1.legend(new_handles, new_labels,
                        loc='upper center',
                        bbox_to_anchor=(0.5, 0.98), 
                        ncol=2,                 
                        fontsize=12,            
                        columnspacing=1.5,      
                        handletextpad=0.5,      
                        borderpad=0.4,          
                        frameon=True)

    legend.get_frame().set_edgecolor('black')
    legend.get_frame().set_facecolor('white') # Thêm màu nền trắng cho legend để không bị lẫn với mây
    legend.get_frame().set_alpha(0.9)         # Độ đục của legend

    ax1.set_box_aspect(0.9) 

    plt.tight_layout()
    plt.show()

if __name__ == "__main__":
    main()
